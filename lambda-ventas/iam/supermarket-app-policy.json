{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTablasSupermarket",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Ventas",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Productos",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Ventas/index/*",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Productos/index/*"
      ]
    },
    {
      "Sid": "LambdaFuncionesSupermarket",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListVersionsByFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:000000000000:function:ventas-post",
        "arn:aws:lambda:us-east-1:000000000000:function:productos-get"
      ]
    },
    {
      "Sid": "ApiGatewaySupermarket",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE",
        "apigateway:HEAD",
        "apigateway:OPTIONS"
      ],
      "Resource": "arn:aws:apigateway:us-east-1::/*"
    },
    {
      "Sid": "InvokeApiRestSupermarket",
      "Effect": "Allow",
      "Action": "execute-api:Invoke",
      "Resource": "arn:aws:execute-api:us-east-1:000000000000:*/*/*"
    }
  ]
}
