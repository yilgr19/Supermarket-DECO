# --- Backend Spring Boot (pos-sales-api, puerto 8088) ---
# Dejar vacío VITE_API_BASE_URL y usar proxy Vite (/api → 127.0.0.1:8088)
VITE_SALES_API_URL=
VITE_USE_MSW=true

# --- Backend lambda-ventas (WSL + LocalStack) ---
# Tras ./scripts/localstack-setup-api.sh en WSL, copiar BASE_URL (sin barra final):
# VITE_API_BASE_URL=http://localhost:4566/restapis/TU_API_ID/prod/_user_request_
# VITE_USE_MSW=false
# VITE_SALES_API_URL=

VITE_API_BASE_URL=
VITE_TERMINAL_ID=TERM-001
VITE_STORE_NAME=Supermercado POS
